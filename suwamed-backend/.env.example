PORT=5000
NODE_ENV=production

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

JWT_SECRET=<generate-a-random-64-byte-hex-string>
JWT_REFRESH_SECRET=<generate-a-random-64-byte-hex-string>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=false

OPENAI_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

### Email (OTP / password reset / notifications) ###
# Provider preference (highest first):
#   1. SENDGRID_API_KEY  — easiest path; free 100/day. Verify your sender domain in SendGrid first.
#   2. SMTP_HOST/USER/PASS — generic SMTP (Mailgun, Postmark, Mailtrap-staging, Gmail-with-app-password).
# If none of the variables below are set, OTPs are logged to the dev console only — useful for local
# development; do NOT deploy to production without a real provider.
SENDGRID_API_KEY=
FROM_EMAIL=noreply@suwamed.lk
FROM_NAME=SuwaMed

# Generic SMTP fallback. Leave SENDGRID_API_KEY empty to use this path.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

### SMS (placeholder — Twilio integration not yet wired) ###
# When ready, build src/services/sms.service.ts and read these vars there.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Comma-separated list of allowed *browser* origins for CORS.
#  - Native mobile apps don't send an Origin header and are always allowed.
#  - Leave empty in production to reject all browser origins (admin web app must be added explicitly).
#  - "*" allows all browser origins — for local dev only; the server will warn on production startup.
# Examples:
#   ALLOWED_ORIGINS=https://suwamed.lk,https://app.suwamed.lk
#   ALLOWED_ORIGINS=                # production default — block all browser origins
#   ALLOWED_ORIGINS=*               # dev only
ALLOWED_ORIGINS=
