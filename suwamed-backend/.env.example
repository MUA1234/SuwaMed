PORT=5000
NODE_ENV=production

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

JWT_SECRET=<generate-a-random-64-byte-hex-string>
JWT_REFRESH_SECRET=<generate-a-random-64-byte-hex-string>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=false

OPENAI_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SENDGRID_API_KEY=
FROM_EMAIL=noreply@suwamed.lk

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Comma-separated list of allowed origins for CORS (e.g., https://suwamed.lk,https://app.suwamed.lk)
# Use * to allow all origins (not recommended for production)
ALLOWED_ORIGINS=*
