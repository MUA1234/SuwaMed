  "consent": {
    "title": "Before You Begin",
    "subtitle": "Please read and accept these terms to continue.",
    "medicalDisclaimerTitle": "Medical Disclaimer",
    "medicalDisclaimerBody": "SuwaMed is a telehealth platform that connects you with licensed Sri Lankan doctors. The AI symptom checker is for informational guidance only and is NOT a substitute for professional medical diagnosis. In a life-threatening emergency, call 1990 (Suwa Seriya) immediately.",
    "dataUseTitle": "How We Use Your Data",
    "dataUseBody": "We collect your name, contact details, payment records and any health information you choose to share with your doctor. We never sell your data. Your medical records are encrypted at rest and in transit, and only shared with the doctors you book with.",
    "consentLineMedical": "I understand that SuwaMed is not for medical emergencies and that AI suggestions are not a diagnosis.",
    "consentLineData": "I agree to the {{terms}} and {{privacy}}.",
    "consentLineAge": "I confirm I am 18 years or older, or have a parent/guardian's consent to use this service.",
    "acceptAndContinue": "I Accept — Continue",
    "mustAcceptAll": "Please tick all three boxes to continue."
  },
  "privacy": {
    "title": "Privacy Policy",
    "lastUpdated": "Last updated: April 2026",
    "section1Title": "1. Information We Collect",
    "section1Body": "We collect: account details (name, email, phone, date of birth, gender, district), authentication data (hashed password, OTP, refresh tokens), health information you upload or share with doctors (medical records, symptoms, prescriptions), appointment and payment history, and device information (FCM push token, app version, language).",
    "section2Title": "2. How We Use Your Information",
    "section2Body": "Your data is used to: (a) deliver the telehealth service — booking, consultations, prescriptions, payments; (b) verify doctor credentials with the Sri Lanka Medical Council; (c) send you appointment reminders and account notifications; (d) improve safety and detect abuse; (e) comply with legal obligations.",
    "section3Title": "3. Sharing",
    "section3Body": "Health records are shared only with the doctor you have booked with. Payment processors (PayHere when enabled) receive only the amount and reference. We never sell your personal data to third parties.",
    "section4Title": "4. Storage & Security",
    "section4Body": "Records are encrypted in transit (TLS) and at rest. Passwords, OTPs and refresh tokens are hashed using bcrypt. Files uploaded by patients are stored on Cloudinary in private folders.",
    "section5Title": "5. Your Rights",
    "section5Body": "You can view, edit or delete your account from Settings. Deleting your account permanently erases your personal information and health records. Appointment and billing records are retained for legal and audit purposes for 7 years, but are no longer linked to identifying information.",
    "section6Title": "6. Children",
    "section6Body": "SuwaMed is intended for users aged 18 and over, or for minors with the consent of a parent or guardian who agrees to supervise their use of the service.",
    "section7Title": "7. Contact",
    "section7Body": "If you have questions about this policy, contact us at privacy@suwamed.lk."
  },
  "terms": {
    "title": "Terms of Service",
    "lastUpdated": "Last updated: April 2026",
    "section1Title": "1. Acceptance",
    "section1Body": "By creating an account or using SuwaMed, you agree to these Terms of Service and our Privacy Policy. If you do not agree, do not use the service.",
    "section2Title": "2. Not for Emergencies",
    "section2Body": "SuwaMed does not provide emergency medical services. If you believe you are experiencing a medical emergency, call 1990 (Suwa Seriya) or visit your nearest hospital.",
    "section3Title": "3. AI Symptom Checker",
    "section3Body": "The symptom checker provides general health information based on the symptoms you describe. It is NOT a medical diagnosis and is NOT a substitute for evaluation by a licensed doctor.",
    "section4Title": "4. Doctor Consultations",
    "section4Body": "Doctors on SuwaMed are independently licensed by the Sri Lanka Medical Council. SuwaMed facilitates the connection but is not responsible for the medical advice provided. The doctor-patient relationship is between you and the doctor.",
    "section5Title": "5. Payments & Refunds",
    "section5Body": "Consultation fees are set by individual doctors. Payments made for completed consultations are non-refundable. Cancellations made more than 24 hours before the appointment are eligible for a full refund. We do not control or guarantee any external payment provider.",
    "section6Title": "6. User Conduct",
    "section6Body": "You agree to provide accurate information, not to impersonate other users, doctors or entities, and not to use SuwaMed for unlawful purposes. We may suspend or terminate accounts that violate these terms.",
    "section7Title": "7. Limitation of Liability",
    "section7Body": "SuwaMed is provided \"as is\" without warranties of any kind. To the maximum extent permitted by law, we are not liable for any indirect, incidental, or consequential damages arising from your use of the service.",
    "section8Title": "8. Changes",
    "section8Body": "We may update these terms from time to time. Continued use of SuwaMed after changes constitutes acceptance of the new terms."
  }
