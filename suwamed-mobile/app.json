{
  "expo": {
    "name": "SuwaMed",
    "slug": "suwamed-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mua1234.suwamedmobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "SuwaMed needs camera access so you can capture photos of medical records, take a profile picture, and join video consultations with your doctor.",
        "NSMicrophoneUsageDescription": "SuwaMed needs microphone access so you can speak during video consultations with your doctor.",
        "NSPhotoLibraryUsageDescription": "SuwaMed needs photo library access so you can attach existing medical records and choose a profile picture.",
        "NSPhotoLibraryAddUsageDescription": "SuwaMed saves consultation receipts and prescriptions to your photo library on request.",
        "NSLocationWhenInUseUsageDescription": "SuwaMed uses your location to show nearby pharmacies and enable emergency services."
      }
    },
    "android": {
      "package": "com.mua1234.suwamedmobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "bcf54311-9b6d-41b8-bbfb-528e6c299d7e"
      }
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1A73E8",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SuwaMed needs camera access to capture medical records, take profile pictures, and run video consultations.",
          "microphonePermission": "SuwaMed needs microphone access for video consultations.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SuwaMed needs photo library access so you can attach existing medical records and choose a profile picture.",
          "cameraPermission": "SuwaMed needs camera access so you can capture medical records and take a profile picture."
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bcf54311-9b6d-41b8-bbfb-528e6c299d7e"
    }
  }
}
